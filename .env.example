# WinBoat Bridge Configuration
# Copy this file to .env and customize the values

# Path to winboat-bridge.exe on Windows (used for bootstrap)
# Note: Use double backslashes for Windows paths
WINBOAT_EXE_PATH=C:\\Users\\gianca\\Desktop\\Shared\\rust\\winboat-bridge\\target\\release\\winboat-bridge.exe

# WinRM connection settings (for bootstrap via WinRM)
WINBOAT_HOST=127.0.0.1
WINBOAT_PORT=47320
WINBOAT_USER=gianca
WINBOAT_PASS=gianca

# Server log paths (Windows paths)
# Note: Use double backslashes for Windows paths
WINBOAT_LOG_PATH=C:\\Users\\gianca\\server.log
WINBOAT_ERR_PATH=C:\\Users\\gianca\\server.err

# Network ports
WINBOAT_SERVER_PORT=5330   # Port the server listens on (Windows side)
WINBOAT_CLIENT_PORT=47330  # Port the client connects to (Linux side, mapped to container)

# --- Multiple environments (optional) ---
# The .env can hold N named host configurations using prefixed keys:
#   WINBOAT_<NAME>_<FIELD>   (e.g. WINBOAT_PROD_HOST)
# WINBOAT_ENV selects the active environment; unprefixed keys above are the
# fallback for fields missing in the named env.
# Reserved names: ENV, SERVER, CLIENT, DEFAULT.
# Manage environments with: winboat-bridge env list|show|add|set|remove|use
#
# WINBOAT_ENV=PROD
# WINBOAT_PROD_HOST=10.0.0.5
# WINBOAT_PROD_PORT=5985
# WINBOAT_PROD_USER=administrator
# WINBOAT_PROD_PASS=secret
# WINBOAT_PROD_EXE_PATH=C:\\tools\\winboat-bridge.exe
# WINBOAT_PROD_CLIENT_PORT=5330
# WINBOAT_PROD_SERVER_PORT=5330
# WINBOAT_PROD_SEGMENT_SIZE=67108864   # optional: transfer segment bytes (1MB-256MB)
