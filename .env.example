# CrossPilot Configuration
# Copy this file to .env and customize the values

# Path to crosspilot.exe on Windows (used for bootstrap)
# Note: Use double backslashes for Windows paths
CROSSPILOT_EXE_PATH=C:\\Users\\gianca\\Desktop\\Shared\\rust\\crosspilot\\target\\release\\crosspilot.exe

# WinRM connection settings (for bootstrap via WinRM)
CROSSPILOT_HOST=127.0.0.1
CROSSPILOT_PORT=47320
CROSSPILOT_USER=gianca
CROSSPILOT_PASS=gianca

# Server log paths (Windows paths)
# Note: Use double backslashes for Windows paths
CROSSPILOT_LOG_PATH=C:\\Users\\gianca\\server.log
CROSSPILOT_ERR_PATH=C:\\Users\\gianca\\server.err

# Network ports
CROSSPILOT_SERVER_PORT=5330   # Port the server listens on (Windows side)
CROSSPILOT_CLIENT_PORT=47330  # Port the client connects to (Linux side, mapped to container)

# --- Multiple environments (optional) ---
# The .env can hold N named host configurations using prefixed keys:
#   CROSSPILOT_<NAME>_<FIELD>   (e.g. CROSSPILOT_PROD_HOST)
# CROSSPILOT_ENV selects the active environment; unprefixed keys above are the
# fallback for fields missing in the named env.
# Reserved names: ENV, SERVER, CLIENT, DEFAULT.
# Manage environments with: crosspilot env list|show|add|set|remove|use
#
# CROSSPILOT_ENV=PROD
# CROSSPILOT_PROD_HOST=10.0.0.5
# CROSSPILOT_PROD_PORT=5985
# CROSSPILOT_PROD_USER=administrator
# CROSSPILOT_PROD_PASS=secret
# CROSSPILOT_PROD_EXE_PATH=C:\\tools\\crosspilot.exe
# CROSSPILOT_PROD_CLIENT_PORT=5330
# CROSSPILOT_PROD_SERVER_PORT=5330
# CROSSPILOT_PROD_SEGMENT_SIZE=67108864   # optional: transfer segment bytes (1MB-256MB)
