/target
*.log
# L'exe Windows embeddato è un artefatto di build (prodotto da scripts/build-release.sh).
# Non va committato: viene rigenerato ad ogni build-release.
/assets/crosspilot.exe
# .env contiene credenziali reali (WinRM password). Non committare mai.
# Usa .env.example come template.
.env
# Keystore TOFU del canale SSH unificato (russh): host key registrate al
# primo connect. Stato runtime accanto al .env — non committare.
crosspilot_known_hosts
# Anche il sidecar linux musl e' un artefatto di build (build-release.sh).
/assets/crosspilot.linux
