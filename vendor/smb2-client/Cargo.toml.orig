[package]
name = "smb2-client"
version = "0.2.5"
edition = "2021"
rust-version = "1.74"
description = "Minimal async SMB2 client in pure Rust: negotiate, NTLMv2 (SPNEGO) session setup, message signing (HMAC-SHA256 / AES-CMAC), tree connect, named-pipe and file I/O — no FFI."
license = "MIT"
repository = "https://github.com/icedracon/smb2-client"
documentation = "https://docs.rs/smb2-client"
readme = "README.md"
keywords = ["smb", "smb2", "cifs", "ntlm", "windows"]
categories = ["network-programming", "authentication", "os::windows-apis"]

[dependencies]
ntlmssp = "0.1"
thiserror = "2"
tokio = { version = "1", features = ["net", "io-util", "time", "rt", "sync"] }
tracing = "0.1"
hmac = "0.12"
sha2 = "0.10"
rand = "0.8"
aes = "0.8"
cmac = "0.7"

[badges]
maintenance = { status = "actively-developed" }
